diff --git a/src/systems/componentAssignmentContract.js b/src/systems/componentAssignmentContract.js
new file mode 100644
index 0000000..4351a1a
--- /dev/null
+++ b/src/systems/componentAssignmentContract.js
@@ -0,0 +1,33 @@
+// Optional editor integration contract. No consumer-specific storage or behavior.
+export const COMPONENT_ASSIGNMENT_CONTRACT = 'fabricate-component-assignments-v1';
+export const COMPONENTS_DELETED_HOOK = 'fabricate.componentsDeleted';
+
+export function componentSnapshot(records, systemId) {
+  if (!Array.isArray(records)) throw new Error('Invalid persisted crafting systems');
+  const systems = records.filter(record => record?.id === systemId);
+  if (systems.length !== 1 || !Array.isArray(systems[0].components)) {
+    throw new Error('Missing or incomplete persisted crafting system');
+  }
+  const componentIds = systems[0].components.map(component => component?.id);
+  if (componentIds.some(id => typeof id !== 'string' || !id)
+    || new Set(componentIds).size !== componentIds.length) throw new Error('Invalid component IDs');
+  return { systemId, complete: true, componentIds: [...componentIds] };
+}
+
+export function announceComponentDeletions(before, after) {
+  if (!Array.isArray(before) || !Array.isArray(after)) return;
+  for (const system of before) {
+    try {
+      const previous = componentSnapshot(before, system?.id);
+      // Removing a whole system is outside this component contract.
+      const current = componentSnapshot(after, system?.id);
+      const present = new Set(current.componentIds);
+      const componentIds = previous.componentIds.filter(id => !present.has(id));
+      if (componentIds.length) globalThis.Hooks?.callAll(COMPONENTS_DELETED_HOOK,
+        { systemId: previous.systemId, componentIds });
+    } catch (error) {
+      // Notification errors cannot undo a fulfilled persistence operation.
+      console.warn('Fabricate | Component deletion notification unavailable', error);
+    }
+  }
+}
